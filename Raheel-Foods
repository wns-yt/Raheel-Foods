<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NOIR BITES | Clean Fast Food</title>
    <style>
        /* CSS Reset & General Settings */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        :root {
            --black: #000000;
            --dark-gray: #181818;
            --mid-gray: #2e2e2e;
            --border-gray: #444444;
            --light-gray: #a1a1a1;
            --off-white: #f5f5f5;
            --white: #ffffff;
        }

        body {
            background-color: var(--black);
            color: var(--white);
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* Navigation */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 5%;
            border-bottom: 1px solid var(--mid-gray);
            position: sticky;
            top: 0;
            background-color: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(10px);
            z-index: 100;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        nav a {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--light-gray);
            transition: color 0.3s ease;
        }

        nav a:hover {
            color: var(--white);
        }

        .btn-primary {
            background-color: var(--white);
            color: var(--black);
            padding: 0.7rem 1.5rem;
            font-weight: 600;
            border: 1px solid var(--white);
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: var(--black);
            color: var(--white);
        }

        /* Hero Section */
        .hero {
            height: 80vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 1rem;
            background: linear-gradient(180deg, var(--black) 0%, var(--dark-gray) 100%);
            border-bottom: 1px solid var(--mid-gray);
        }

        .hero h1 {
            font-size: 4rem;
            font-weight: 900;
            letter-spacing: 3px;
            margin-bottom: 1rem;
            text-transform: uppercase;
        }

        .hero p {
            color: var(--light-gray);
            max-width: 600px;
            font-size: 1.2rem;
            margin-bottom: 2rem;
            font-weight: 300;
        }

        /* Menu Section */
        .menu-section {
            padding: 5rem 5%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            font-size: 2rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 3rem;
            text-align: center;
            border-bottom: 1px solid var(--mid-gray);
            padding-bottom: 1rem;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .menu-card {
            background-color: var(--dark-gray);
            border: 1px solid var(--mid-gray);
            padding: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

        .menu-card:hover {
            transform: translateY(-5px);
            border-color: var(--light-gray);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 1rem;
        }

        .item-name {
            font-size: 1.25rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .item-price {
            font-size: 1.2rem;
            color: var(--light-gray);
            font-weight: 600;
        }

        .item-desc {
            color: var(--light-gray);
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
            font-weight: 300;
        }

        .card-btn {
            background-color: transparent;
            color: var(--white);
            border: 1px solid var(--border-gray);
            padding: 0.6rem 1rem;
            width: 100%;
            cursor: pointer;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .card-btn:hover {
            background-color: var(--white);
            color: var(--black);
        }

        /* Order / Cart Modal Sidebar */
        .cart-modal {
            position: fixed;
            top: 0;
            right: -400px;
            width: 350px;
            height: 100%;
            background-color: var(--dark-gray);
            border-left: 1px solid var(--mid-gray);
            box-shadow: -5px 0 15px rgba(0,0,0,0.5);
            padding: 2rem;
            display: flex;
            flex-direction: column;
            transition: right 0.3s ease;
            z-index: 200;
        }

        .cart-modal.active {
            right: 0;
        }

        .cart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--mid-gray);
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
        }

        .close-cart {
            background: none;
            border: none;
            color: var(--white);
            font-size: 1.5rem;
            cursor: pointer;
        }

        .cart-items {
            flex-grow: 1;
            overflow-y: auto;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
            border-bottom: 1px solid var(--mid-gray);
            padding-bottom: 0.5rem;
        }

        .cart-footer {
            border-top: 1px solid var(--mid-gray);
            padding-top: 1rem;
        }

        /* Footer */
        footer {
            border-top: 1px solid var(--mid-gray);
            padding: 3rem 5%;
            text-align: center;
            color: var(--light-gray);
            font-size: 0.85rem;
        }

        @media (max-width: 768px) {
            .hero h1 { font-size: 2.5rem; }
            nav { display: none; }
        }
    </style>
</head>
<body>

    <!-- Header / Navbar -->
    <header>
        <div class="logo">NOIR BITES</div>
        <nav>
            <ul>
                <li><a href="#menu">Menu</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#location">Locations</a></li>
            </ul>
        </nav>
        <button class="btn-primary" onclick="toggleCart()">Cart (<span id="cart-count">0</span>)</button>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <h1>FAST. MINIMAL. DELICIOUS.</h1>
        <p>Premium grade fast food made with minimal ingredients and maximum flavor.</p>
        <a href="#menu" class="btn-primary">View Menu</a>
    </section>

    <!-- Menu Section -->
    <section class="menu-section" id="menu">
        <h2 class="section-title">Essential Menu</h2>
        <div class="menu-grid">
            
            <!-- Item 1 -->
            <div class="menu-card">
                <div>
                    <div class="card-header">
                        <span class="item-name">Noir Burger</span>
                        <span class="item-price">$9.50</span>
                    </div>
                    <p class="item-desc">Double smash beef patty, black garlic mayo, sharp cheddar, artisan bun.</p>
                </div>
                <button class="card-btn" onclick="addToCart('Noir Burger', 9.50)">Add to Order</button>
            </div>

            <!-- Item 2 -->
            <div class="menu-card">
                <div>
                    <div class="card-header">
                        <span class="item-name">Monochrome Fries</span>
                        <span class="item-price">$4.00</span>
                    </div>
                    <p class="item-desc">Hand-cut double cooked potatoes, truffle salt, charcoal dip.</p>
                </div>
                <button class="card-btn" onclick="addToCart('Monochrome Fries', 4.00)">Add to Order</button>
            </div>

            <!-- Item 3 -->
            <div class="menu-card">
                <div>
                    <div class="card-header">
                        <span class="item-name">Crispy Chicken</span>
                        <span class="item-price">$8.50</span>
                    </div>
                    <p class="item-desc">Triple buttermilk fried chicken thigh, spicy slaw, house pickles.</p>
                </div>
                <button class="card-btn" onclick="addToCart('Crispy Chicken', 8.50)">Add to Order</button>
            </div>

            <!-- Item 4 -->
            <div class="menu-card">
                <div>
                    <div class="card-header">
                        <span class="item-name">Pure Shake</span>
                        <span class="item-price">$5.00</span>
                    </div>
                    <p class="item-desc">Vanilla bean dairy base, dark chocolate crumble, whipped cream.</p>
                </div>
                <button class="card-btn" onclick="addToCart('Pure Shake', 5.00)">Add to Order</button>
            </div>

        </div>
    </section>

    <!-- Cart Modal -->
    <div class="cart-modal" id="cartModal">
        <div class="cart-header">
            <h3>YOUR ORDER</h3>
            <button class="close-cart" onclick="toggleCart()">&times;</button>
        </div>
        <div class="cart-items" id="cartItems">
            <p style="color: var(--light-gray);">Your cart is empty.</p>
        </div>
        <div class="cart-footer">
            <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                <span>Total:</span>
                <span id="cartTotal">$0.00</span>
            </div>
            <button class="btn-primary" style="width: 100%;">Checkout</button>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 NOIR BITES INC. ALL RIGHTS RESERVED.</p>
    </footer>

    <!-- JavaScript for Interactivity -->
    <script>
        let cart = [];

        function toggleCart() {
            document.getElementById('cartModal').classList.toggle('active');
        }

        function addToCart(name, price) {
            cart.push({ name, price });
            updateCart();
        }

        function updateCart() {
            document.getElementById('cart-count').innerText = cart.length;
            const cartItemsContainer = document.getElementById('cartItems');
            
            if (cart.length === 0) {
                cartItemsContainer.innerHTML = '<p style="color: var(--light-gray);">Your cart is empty.</p>';
                document.getElementById('cartTotal').innerText = '$0.00';
                return;
            }

            let html = '';
            let total = 0;

            cart.forEach((item) => {
                total += item.price;
                html += `
                    <div class="cart-item">
                        <span>${item.name}</span>
                        <span>$${item.price.toFixed(2)}</span>
                    </div>
                `;
            });

            cartItemsContainer.innerHTML = html;
            document.getElementById('cartTotal').innerText = `$${total.toFixed(2)}`;
        }
    </script>
</body>
</html>
